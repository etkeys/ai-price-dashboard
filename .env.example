# Copy this file to .env and fill in real values.
# .env is gitignored and should never be committed.

FLASK_APP=run.py

# Configuration selection (used by WSGI servers such as Gunicorn):
#   development  -> debug enabled, falls back to a placeholder SECRET_KEY
#   production   -> debug disabled, requires a non-empty SECRET_KEY
# Direct execution (python run.py) always uses development regardless of this value.
FLASK_CONFIG=development

SECRET_KEY=change-me-in-production

# SQLite connection string. The four-slash absolute form (sqlite:////data/app.db)
# is used in the container with a named volume. The relative form (sqlite:///app.db)
# resolves under the Flask instance folder (<repo>/instance/app.db in development).
DATABASE_URL=sqlite:///app.db
